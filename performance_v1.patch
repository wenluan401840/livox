+// Real-time policy: never let LiDAR latency grow without bound.
+// A navigation front-end should prefer a recent scan over processing every
+// historical scan when CPU load temporarily exceeds the sensor rate.
+static constexpr size_t MAX_LIDAR_BACKLOG = 3;
+uint64_t dropped_lidar_backlog = 0;
+
+// mtx_buffer must already be held when this function is called.  If
+// sync_packages() is waiting for IMU with lidar_pushed=true, index 0 is the
+// scan currently referenced by Measures and must not be removed.
+inline void trim_lidar_backlog_locked()
+{
+    while (lidar_buffer.size() >= MAX_LIDAR_BACKLOG)
+    {
+        if (lidar_pushed && lidar_buffer.size() > 1)
+        {
+            lidar_buffer.erase(lidar_buffer.begin() + 1);
+            time_buffer.erase(time_buffer.begin() + 1);
+        }
+        else
+        {
+            lidar_buffer.pop_front();
+            time_buffer.pop_front();
+        }
+        ++dropped_lidar_backlog;
+    }
+
+    if (dropped_lidar_backlog > 0)
+    {
+        ROS_WARN_THROTTLE(2.0,
+                          "FAST-LIO realtime backlog: dropped %lu old LiDAR scans, buffered=%zu",
+                          static_cast<unsigned long>(dropped_lidar_backlog),
+                          lidar_buffer.size());
+    }
+}
